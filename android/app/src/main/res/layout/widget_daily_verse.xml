<?xml version="1.0" encoding="utf-8"?>
<!-- Daily verse widget, 4x2 by default: date badge and heart on top, the
     verse, then the reference, the translation tag, the mode and the look
     shortcut. The chosen look (a flat colour with matching ink, or a photo
     under a veil — same vocabulary as the share card) is painted at runtime
     into widget_bg by DailyVerseWidgetProvider, which also sets every text
     colour and swaps the pill drawables for the light/dark ink. Only
     RemoteViews-compatible views. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2dp"
                android:textAllCaps="true"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Adds or removes the verse from the favorites, without opening
                 the app (DailyVerseWidgetProvider.onReceive). -->
            <ImageView
                android:id="@+id/widget_heart"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="-6dp"
                android:contentDescription="@string/widget_favorite"
                android:padding="6dp"
                android:src="@drawable/ic_widget_heart" />
        </LinearLayout>

        <!-- Font follows the verse length: a long verse shrinks before it is
             cut (API 26+; older versions keep the provider's fixed size per
             size class). The max stays near reading size: a short verse on a
             large widget otherwise grew to an oversized headline. The chosen
             typeface and size come as spans on the text. -->
        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="4"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_ref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_tag"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:paddingStart="3dp"
                android:paddingTop="1dp"
                android:paddingEnd="3dp"
                android:paddingBottom="1dp"
                android:textAllCaps="true"
                android:textColor="#99FFFFFF"
                android:textSize="9sp" />

            <!-- The mode: "Fampaherezana", or a plan's "Teny ho anao · 5/21". -->
            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />

            <!-- Look shortcut: full row height, so it is an easy target next
                 to the verse tap. -->
            <LinearLayout
                android:id="@+id/widget_settings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:minHeight="28dp"
                android:minWidth="32dp"
                android:paddingStart="8dp">

                <ImageView
                    android:id="@+id/widget_settings_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/widget_settings"
                    android:src="@drawable/ic_widget_tune" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
