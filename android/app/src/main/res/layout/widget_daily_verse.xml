<?xml version="1.0" encoding="utf-8"?>
<!-- Daily verse widget, 4x2 by default: the verse and its reference, nothing
     else. The chosen look (a flat colour with matching ink, or a photo under a
     dark scrim — same vocabulary as the share card) is painted at runtime into
     widget_bg by DailyVerseWidgetProvider, which also sets every colour. Only
     RemoteViews-compatible views. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- A Teny ho anao plan day only ("Teny ho anao · 5/21"). -->
        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Font follows the verse length: a long verse shrinks before it is
             cut (API 26+; older versions keep the provider's fixed size per
             size class). The max stays near reading size: a short verse on a
             large widget otherwise grew to an oversized headline. -->
        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="4"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <!-- A short rule, the reference, and the look shortcut at the end. -->
        <LinearLayout
            android:id="@+id/widget_ref_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- FrameLayout: RemoteViews rejects a bare View. -->
            <FrameLayout
                android:id="@+id/widget_rule"
                android:layout_width="20dp"
                android:layout_height="1.5dp"
                android:layout_marginEnd="8dp"
                android:background="#FFFFFFFF" />

            <TextView
                android:id="@+id/widget_ref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Everything right of the reference, full row height, so the
                 shortcut is an easy target next to the verse tap. -->
            <LinearLayout
                android:id="@+id/widget_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:minHeight="28dp"
                android:paddingStart="8dp">

                <ImageView
                    android:id="@+id/widget_settings_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/widget_settings"
                    android:src="@drawable/ic_widget_tune" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
