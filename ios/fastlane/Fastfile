require "json"

APP_IDENTIFIER = "com.ebaiboly.app"
# The home-screen widget extension is signed separately: its own App ID (with
# the group.com.ebaiboly.app App Group enabled in the developer portal, same
# as the app's) and its own match profile.
WIDGET_IDENTIFIER = "com.ebaiboly.app.DailyVerseWidget"
WIDGET_TARGET = "DailyVerseWidget"
XCODEPROJ = "SmartBaibolyYarn.xcodeproj"
WORKSPACE = "SmartBaibolyYarn.xcworkspace"
SCHEME = "SmartBaibolyYarn"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Creates and unlocks a temporary keychain for match to import into. Without
    # it the cert lands in the runner's login keychain and codesign blocks on a
    # GUI "allow access" prompt that nothing on a headless runner can answer —
    # the first run hung for 70 minutes on "Signing DailyVerseWidget.appex".
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    )

    # readonly is deliberately false: there is no Mac to run match on locally,
    # so the first CI run has to create the distribution cert and profile.
    # match reads MATCH_GIT_URL / MATCH_GIT_BASIC_AUTHORIZATION / MATCH_PASSWORD
    # straight from the environment.
    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER, WIDGET_IDENTIFIER],
      api_key: api_key,
      readonly: false
    )

    update_code_signing_settings(
      path: XCODEPROJ,
      targets: [SCHEME],
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      profile_name: "match AppStore #{APP_IDENTIFIER}",
      code_sign_identity: "Apple Distribution"
    )
    update_code_signing_settings(
      path: XCODEPROJ,
      targets: [WIDGET_TARGET],
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      profile_name: "match AppStore #{WIDGET_IDENTIFIER}",
      code_sign_identity: "Apple Distribution"
    )

    # Marketing version tracks package.json, the same source Android uses.
    # Build number is the CI run number so it can never collide on upload.
    increment_version_number(
      version_number: JSON.parse(File.read(File.expand_path("../../package.json", __dir__)))["version"],
      xcodeproj: XCODEPROJ
    )
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%y%m%d%H%M"),
      xcodeproj: XCODEPROJ
    )

    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true
    )

    pilot(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
