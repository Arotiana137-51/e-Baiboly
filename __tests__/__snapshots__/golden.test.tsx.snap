      "favUrl": "ebaiboly://favorite?key=19:107:1&name=Salamo",
      "key": "19:107:1",
      "label": "Fampaherezana",
      "ref": "Salamo 107:1",
      "text": "Miderà an'i Jehovah, fa tsara Izy. Fa mandrakizay ny famindram-pony.",
      "url": "ebaiboly://verse?book=19&chapter=107&verse=1&name=Salamo",
    },
    "2026-12-10": {
      "dateLabel": "Alk 10 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:26:4&name=Isaia",
      "key": "23:26:4",
      "label": "Fampaherezana",
      "ref": "Isaia 26:4",
      "text": "Matokia an'i Jehovah mandrakizay, fa Jehovah Tompo no Vatolampy mandrakizay.",
      "url": "ebaiboly://verse?book=23&chapter=26&verse=4&name=Isaia",
    },
    "2026-12-11": {
      "dateLabel": "Zom 11 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=9:12:24&name=I%20Samoela",
      "key": "9:12:24",
      "label": "Fampaherezana",
      "ref": "1 Samoela 12:24",
      "text": "Kanefa matahora an'i Jehovah ianareo, ka manompoa Azy marina amin'ny fonareo rehetra; fa eritrereto izao zavatra lehibe nataony ho anareo izao.",
      "url": "ebaiboly://verse?book=9&chapter=12&verse=24&name=I%20Samoela",
    },
    "2026-12-12": {
      "dateLabel": "Sab 12 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=25:3:24&name=Fitomaniana",
      "key": "25:3:24",
      "label": "Fampaherezana",
      "ref": "Fitomaniana 3:24",
      "text": "Jehovah no anjarako, hoy ny fanahiko, ka dia hanantena Azy aho.",
      "url": "ebaiboly://verse?book=25&chapter=3&verse=24&name=Fitomaniana",
    },
    "2026-12-13": {
      "dateLabel": "Alh 13 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=14:16:9&name=II%20Tantara",
      "key": "14:16:9",
      "label": "Fampaherezana",
      "ref": "2 Tantara 16:9",
      "text": "Fa ny mason'i Jehovah mijery eny tontolo eny eran'ny tany rehetra, mba hisehoany aman-kery hamonjy izay manana fo mahitsy aminy. Adala ianao tamin'izany, ka dia hisy ady hahazo anao hatramin'izao.",
      "url": "ebaiboly://verse?book=14&chapter=16&verse=9&name=II%20Tantara",
    },
    "2026-12-14": {
      "dateLabel": "Alt 14 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=20:13:12&name=Ohabolana",
      "key": "20:13:12",
      "label": "Fampaherezana",
      "ref": "Ohabolana 13:12",
      "text": "Ny fanantenana tsy azo vetivety dia mankarary am-bavafo; Fa hazon'aina ny faniriana tanteraka.",
      "url": "ebaiboly://verse?book=20&chapter=13&verse=12&name=Ohabolana",
    },
    "2026-12-15": {
      "dateLabel": "Tal 15 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=45:8:35&name=Romana",
      "key": "45:8:35",
      "label": "Fampaherezana",
      "ref": "Romana 8:35",
      "text": "Iza no hahasaraka antsika amin'ny fitiavan'i Kristy? Fahoriana va, sa fahantrana, sa fanenjehana, sa mosary, sa fitanjahana, sa loza, sa sabatra?",
      "url": "ebaiboly://verse?book=45&chapter=8&verse=35&name=Romana",
    },
    "2026-12-16": {
      "dateLabel": "Alr 16 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=20:19:20&name=Ohabolana",
      "key": "20:19:20",
      "label": "Fampaherezana",
      "ref": "Ohabolana 19:20",
      "text": "Henoy ny saina atolotra, ary raiso ny fananarana, Mba ho hendry ianao amin'izay hiafaranao.",
      "url": "ebaiboly://verse?book=20&chapter=19&verse=20&name=Ohabolana",
    },
    "2026-12-17": {
      "dateLabel": "Alk 17 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=40:28:18&name=Matio",
      "key": "40:28:18",
      "label": "Fampaherezana",
      "ref": "Matio 28:18",
      "text": "Ary Jesosy nanatona dia niteny taminy ka nanao hoe: Efa nomena Ahy ny fahefana rehetra any an-danitra sy ety an-tany;",
      "url": "ebaiboly://verse?book=40&chapter=28&verse=18&name=Matio",
    },
    "2026-12-18": {
      "dateLabel": "Zom 18 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=42:12:24&name=Lioka",
      "key": "42:12:24",
      "label": "Fampaherezana",
      "ref": "Lioka 12:24",
      "text": "Hevero ny goaika; fa tsy mba mamafy na mijinja ireny; ary tsy manana fitoeran-javatra na trano fitehirizana, nefa Andriamanitra mamelona azy; tsy mihoatra lavitra noho ny vorona va ianareo?",
      "url": "ebaiboly://verse?book=42&chapter=12&verse=24&name=Lioka",
    },
    "2026-12-19": {
      "dateLabel": "Sab 19 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=43:14:2&name=Jaona",
      "key": "43:14:2",
      "label": "Fampaherezana",
      "ref": "Jaona 14:2",
      "text": "Ao an-tranon'ny Raiko misy fitoerana maro; raha tsy izany, dia efa nilaza taminareo Aho; fa handeha hamboatra fitoerana ho anareo Aho.",
      "url": "ebaiboly://verse?book=43&chapter=14&verse=2&name=Jaona",
    },
    "2026-12-20": {
      "dateLabel": "Alh 20 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=45:10:13&name=Romana",
      "key": "45:10:13",
      "label": "Fampaherezana",
      "ref": "Romana 10:13",
      "text": "Fa izay rehetra miantso ny anaran'ny Tompo no hovonjena.",
      "url": "ebaiboly://verse?book=45&chapter=10&verse=13&name=Romana",
    },
    "2026-12-21": {
      "dateLabel": "Alt 21 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=42:6:37&name=Lioka",
      "key": "42:6:37",
      "label": "Fampaherezana",
      "ref": "Lioka 6:37",
      "text": "Ary aza mitsara, dia tsy hotsaraina ianareo; aza manameloka, dia tsy hohelohina ianareo; mamelà, dia mba havela ianareo;",
      "url": "ebaiboly://verse?book=42&chapter=6&verse=37&name=Lioka",
    },
    "2026-12-22": {
      "dateLabel": "Tal 22 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=46:13:8&name=I%20Korintiana",
      "key": "46:13:8",
      "label": "Fampaherezana",
      "ref": "1 Korintiana 13:8",
      "text": "Ny fitiavana tsy ho levona mandrakizay; fa raha ny faminaniana, dia ho levona; na ny fiteny tsy fantatra, dia hitsahatra; na ny fahalalana, dia ho foana.",
      "url": "ebaiboly://verse?book=46&chapter=13&verse=8&name=I%20Korintiana",
    },
    "2026-12-23": {
      "dateLabel": "Alr 23 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=50:4:19&name=Filipiana",
      "key": "50:4:19",
      "label": "Fampaherezana",
      "ref": "Filipiana 4:19",
      "text": "Fa Andriamanitro hahatanteraka izay rehetra tokony ho anareo araka ny hareny amin'ny voninahitra ao amin'i Kristy Jesosy.",
      "url": "ebaiboly://verse?book=50&chapter=4&verse=19&name=Filipiana",
    },
    "2026-12-24": {
      "dateLabel": "Alk 24 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=42:2:10-11&name=Lioka",
      "key": "42:2:10-11",
      "label": "Fampaherezana",
      "ref": "Lioka 2:10-11",
      "text": "Ary hoy ny anjely taminy: Aza matahotra; fa, indro, milaza teny soa mahafaly aminareo aho, dia fifaliana lehibe izay ho an'ny olona rehetra; fa Mpamonjy no teraka ho anareo anio ao an-tanànan'i Davida, dia Kristy Tompo.",
      "url": "ebaiboly://verse?book=42&chapter=2&verse=10&name=Lioka",
    },
    "2026-12-25": {
      "dateLabel": "Zom 25 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:9:5&name=Isaia",
      "key": "23:9:5",
      "label": "Fampaherezana",
      "ref": "Isaia 9:5",
      "text": "Fa Zaza no teraka ho antsika, Zazalahy no omena antsika; Ary ny fanapahana dia eo an-tsorony, ary ny anarany atao hoe Mahagaga, Mpanolo-tsaina, Andriamanitra Mahery, Rain'ny mandrakizay Andrian'ny fiadanana.",
      "url": "ebaiboly://verse?book=23&chapter=9&verse=5&name=Isaia",
    },
    "2026-12-26": {
      "dateLabel": "Sab 26 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=43:1:14&name=Jaona",
      "key": "43:1:14",
      "label": "Fampaherezana",
      "ref": "Jaona 1:14",
      "text": "Ary ny Teny dia tonga nofo ka nonina tamintsika; ary hitanay ny voninahiny, dia voninahitra miendrika ho an'ny Lahitokana avy tamin'ny Ray, sady feno fahasoavana sy fahamarinana.",
      "url": "ebaiboly://verse?book=43&chapter=1&verse=14&name=Jaona",
    },
    "2026-12-27": {
      "dateLabel": "Alh 27 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=62:5:13&name=I%20Jaona",
      "key": "62:5:13",
      "label": "Fampaherezana",
      "ref": "1 Jaona 5:13",
      "text": "Izany no nosoratako aminareo, izay mino ny anaran'ny Zanak'Andriamanitra, mba ho fantatrareo fa manana fiainana mandrakizay ianareo.",
      "url": "ebaiboly://verse?book=62&chapter=5&verse=13&name=I%20Jaona",
    },
    "2026-12-28": {
      "dateLabel": "Alt 28 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:119:105&name=Salamo",
      "key": "19:119:105",
      "label": "Fampaherezana",
      "ref": "Salamo 119:105",
      "text": "Fanilon'ny tongotro Sy fanazavana ny lalako ny teninao.",
      "url": "ebaiboly://verse?book=19&chapter=119&verse=105&name=Salamo",
    },
    "2026-12-29": {
      "dateLabel": "Tal 29 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:119:114&name=Salamo",
      "key": "19:119:114",
      "label": "Fampaherezana",
      "ref": "Salamo 119:114",
      "text": "Fiereko sy ampingako Ianao; Ny teninao no andrasako.",
      "url": "ebaiboly://verse?book=19&chapter=119&verse=114&name=Salamo",
    },
    "2026-12-30": {
      "dateLabel": "Alr 30 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:119:165&name=Salamo",
      "key": "19:119:165",
      "label": "Fampaherezana",
      "ref": "Salamo 119:165",
      "text": "Be fiadanana izay tia ny lalànao, Ary tsy misy mahatafintohina azy.",
      "url": "ebaiboly://verse?book=19&chapter=119&verse=165&name=Salamo",
    },
    "2026-12-31": {
      "dateLabel": "Alk 31 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:5:20&name=Isaia",
      "key": "23:5:20",
      "label": "Fampaherezana",
      "ref": "Isaia 5:20",
      "text": "Lozan'izay milaza ny ratsy ho tsara ary na tsara ho ratsy! Izay manao ny maizina ho mavaza ary ny mazava ho maizina! Izay manao ny mangidy ho mamy ary ny mamy ho mangidy!",
      "url": "ebaiboly://verse?book=23&chapter=5&verse=20&name=Isaia",
    },
    "2027-01-01": {
      "dateLabel": "Zom 1 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:23:1&name=Salamo",
      "key": "19:23:1",
      "label": "Fampaherezana",
      "ref": "Salamo 23:1",
      "text": "Salamo nataon'i Davida. Jehovah no Mpiandry ahy, tsy hanan-java-mahory aho,",
      "url": "ebaiboly://verse?book=19&chapter=23&verse=1&name=Salamo",
    },
    "2027-01-02": {
      "dateLabel": "Sab 2 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:23:4&name=Salamo",
      "key": "19:23:4",
      "label": "Fampaherezana",
      "ref": "Salamo 23:4",
      "text": "Eny, na dia mandeha mamaky ny lohasaha aloky ny fahafatesana aza aho, dia tsy hatahotra ny loza aho, fa Ianao no amiko; ny tsorakazonao sy ny tehinao, ireo no mahafa-tahotra ahy.",
      "url": "ebaiboly://verse?book=19&chapter=23&verse=4&name=Salamo",
    },
    "2027-01-03": {
      "dateLabel": "Alh 3 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:23:6&name=Salamo",
      "key": "19:23:6",
      "label": "Fampaherezana",
      "ref": "Salamo 23:6",
      "text": "Eny tokoa, fahasoavana sy famindram-po no hanaraka ahy amin'ny andro rehetra hiainako, dia hitoetra ao an-tranon'i Jehovah andro lava aho.",
      "url": "ebaiboly://verse?book=19&chapter=23&verse=6&name=Salamo",
    },
    "2027-01-04": {
      "dateLabel": "Alt 4 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:41:10&name=Isaia",
      "key": "23:41:10",
      "label": "Fampaherezana",
      "ref": "Isaia 41:10",
      "text": "Aza matahotra ianao, fa momba anao Aho; Ary aza miherikerika foana, fa Izaho no Andriamanitrao; Mampahery anao Aho sady mamonjy anao; Eny, mitantana anao amin'ny tanana ankavanan'ny fahamarinako Aho.",
      "url": "ebaiboly://verse?book=23&chapter=41&verse=10&name=Isaia",
    },
    "2027-01-05": {
      "dateLabel": "Tal 5 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=48:5:16&name=Galatiana",
      "key": "48:5:16",
      "label": "Fampaherezana",
      "ref": "Galatiana 5:16",
      "text": "Fa hoy izaho: Mandehana araka ny Fanahy, dia tsy hahatanteraka ny filan'ny nofo ianareo.",
      "url": "ebaiboly://verse?book=48&chapter=5&verse=16&name=Galatiana",
    },
    "2027-01-06": {
      "dateLabel": "Alr 6 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=24:29:11&name=Jeremia",
      "key": "24:29:11",
      "label": "Fampaherezana",
      "ref": "Jeremia 29:11",
      "text": "Fa Izaho mahalala ny hevitra iheverako anareo, hoy Jehovah, dia hevitra hahatonga fiadanana, fa tsy loza, mba hanome anareo fanantenana ny amin'ny farany.",
      "url": "ebaiboly://verse?book=24&chapter=29&verse=11&name=Jeremia",
    },
    "2027-01-07": {
      "dateLabel": "Alk 7 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=5:31:6&name=Deoteronomia",
      "key": "5:31:6",
      "label": "Fampaherezana",
      "ref": "Deotoronomia 31:6",
      "text": "Mahereza sy matanjaha; aza matahotra na manahy azy; fa Jehovah Andriamanitrao no miara-mandeha aminao; tsy handao anao na hahafoy anao Izy.",
      "url": "ebaiboly://verse?book=5&chapter=31&verse=6&name=Deoteronomia",
    },
    "2027-01-08": {
      "dateLabel": "Zom 8 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=20:3:5-6&name=Ohabolana",
      "key": "20:3:5-6",
      "label": "Fampaherezana",
      "ref": "Ohabolana 3:5-6",
      "text": "Matokia an'i Jehovah amin'ny fonao rehetra, Fa aza miankina amin'ny fahalalanao; Maneke Azy amin'ny alehanao rehetra, Fa Izy handamina ny lalanao,",
      "url": "ebaiboly://verse?book=20&chapter=3&verse=5&name=Ohabolana",
    },
    "2027-01-09": {
      "dateLabel": "Sab 9 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=36:3:17&name=Zefania",
      "key": "36:3:17",
      "label": "Fampaherezana",
      "ref": "Zefania 3:17",
      "text": "Jehovah Andriamanitrao no ao aminao, Mahery Izy ka hamonjy; Hiravoravo anao amin'ny fifaliana Izy; Ho sondriana amin'ny fitiavany Izy; Hifaly anao amin'ny fihobiana Izy.",
      "url": "ebaiboly://verse?book=36&chapter=3&verse=17&name=Zefania",
    },
    "2027-01-10": {
      "dateLabel": "Alh 10 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:51:10&name=Salamo",
      "key": "19:51:10",
      "label": "Fampaherezana",
      "ref": "Salamo 51:10",
      "text": "Amorony fo madio aho, Andriamanitra o; ary havaozy hiorina marina ny fanahiko ato anatiko.",
      "url": "ebaiboly://verse?book=19&chapter=51&verse=10&name=Salamo",
    },
    "2027-01-11": {
      "dateLabel": "Alt 11 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=40:11:28&name=Matio",
      "key": "40:11:28",
      "label": "Fampaherezana",
      "ref": "Matio 11:28",
      "text": "Mankanesa aty amiko, ianareo rehetra izay miasa fatratra sy mavesatra entana, fa Izaho no hanome anareo fitsaharana.",
      "url": "ebaiboly://verse?book=40&chapter=11&verse=28&name=Matio",
    },
    "2027-01-12": {
      "dateLabel": "Tal 12 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=42:1:37&name=Lioka",
      "key": "42:1:37",
      "label": "Fampaherezana",
      "ref": "Lioka 1:37",
      "text": "Fa tsy hisy tsy ho tanteraka ny teny rehetra ataon'Andriamanitra.",
      "url": "ebaiboly://verse?book=42&chapter=1&verse=37&name=Lioka",
    },
    "2027-01-13": {
      "dateLabel": "Alr 13 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=43:3:16&name=Jaona",
      "key": "43:3:16",
      "label": "Fampaherezana",
      "ref": "Jaona 3:16",
      "text": "Fa toy izao no nitiavan'Andriamanitra izao tontolo izao: nomeny ny Zanani-lahy Tokana, mba tsy ho very izay rehetra mino Azy, fa hanana fiainana mandrakizay.",
      "url": "ebaiboly://verse?book=43&chapter=3&verse=16&name=Jaona",
    },
    "2027-01-14": {
      "dateLabel": "Alk 14 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=45:8:28&name=Romana",
      "key": "45:8:28",
      "label": "Fampaherezana",
      "ref": "Romana 8:28",
      "text": "Ary fantatsika fa ny zavatra rehetra dia miara-miasa hahasoa izay tia an'Andriamanitra, dia izay voantso araka ny fikasany rahateo.",
      "url": "ebaiboly://verse?book=45&chapter=8&verse=28&name=Romana",
    },
    "2027-01-15": {
      "dateLabel": "Zom 15 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=40:3:2&name=Matio",
      "key": "40:3:2",
      "label": "Fampaherezana",
      "ref": "Matio 3:2",
      "text": "Mibebaha ianareo; fa efa akaiky ny fanjakan'ny lanitra.",
      "url": "ebaiboly://verse?book=40&chapter=3&verse=2&name=Matio",
    },
    "2027-01-16": {
      "dateLabel": "Sab 16 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=46:10:13&name=I%20Korintiana",
      "key": "46:10:13",
      "label": "Fampaherezana",
      "ref": "1 Korintiana 10:13",
      "text": "Tsy misy fakam-panahy nahazo anareo afa-tsy izay zakan'ny olombelona; nefa mahatoky Andriamanitra ka tsy hamela anareo halaim-panahy mihoatra noho izay zakanareo; fa momba ny fakam-panahy dia hasiany lalana hahafahanareo koa mba hahazakanareo izany.",
      "url": "ebaiboly://verse?book=46&chapter=10&verse=13&name=I%20Korintiana",
    },
    "2027-01-17": {
      "dateLabel": "Alh 17 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=50:4:13&name=Filipiana",
      "key": "50:4:13",
      "label": "Fampaherezana",
      "ref": "Filipiana 4:13",
      "text": "Mahay ny zavatra rehetra aho ao amin'ilay mampahery ahy.",
      "url": "ebaiboly://verse?book=50&chapter=4&verse=13&name=Filipiana",
    },
    "2027-01-18": {
      "dateLabel": "Alt 18 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=58:11:1&name=Hebreo",
      "key": "58:11:1",
      "label": "Fampaherezana",
      "ref": "Hebreo 11:1",
      "text": "Ary ny finoana no fahatokiana ny amin'ny zavatra antenaina, fanehoana ny zavatra tsy hita.",
      "url": "ebaiboly://verse?book=58&chapter=11&verse=1&name=Hebreo",
    },
    "2027-01-19": {
      "dateLabel": "Tal 19 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=60:5:7&name=I%20Petera",
      "key": "60:5:7",
      "label": "Fampaherezana",
      "ref": "1 Petera 5:7",
      "text": "Ary apetraho aminy ny fanahianareo rehetra; fa Izy no miahy anareo.",
      "url": "ebaiboly://verse?book=60&chapter=5&verse=7&name=I%20Petera",
    },
    "2027-01-20": {
      "dateLabel": "Alr 20 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=48:6:7&name=Galatiana",
      "key": "48:6:7",
      "label": "Fampaherezana",
      "ref": "Galatiana 6:7",
      "text": "Aza mety hofitahina ianareo; Andriamanitra tsy azo vazivazina, fa izay afafin'ny olona no hojinjany.",
      "url": "ebaiboly://verse?book=48&chapter=6&verse=7&name=Galatiana",
    },
    "2027-01-21": {
      "dateLabel": "Alk 21 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=62:4:4&name=I%20Jaona",
      "key": "62:4:4",
      "label": "Fampaherezana",
      "ref": "1 Jaona 4:4",
      "text": "Anaka, ianareo dia avy amin'Andriamanitra ary efa naharesy ireny, satria lehibe Izay ao aminareo noho izay ao amin'izao tontolo izao.",
      "url": "ebaiboly://verse?book=62&chapter=4&verse=4&name=I%20Jaona",
    },
    "2027-01-22": {
      "dateLabel": "Zom 22 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:28:7&name=Salamo",
      "key": "19:28:7",
      "label": "Fampaherezana",
      "ref": "Salamo 28:7",
      "text": "Jehovah no heriko sy ampingako; izy no nitokian'ny foko, ka voavonjy aho; dia mifaly ny foko, ka ny hirako no hiderako Azy.",
      "url": "ebaiboly://verse?book=19&chapter=28&verse=7&name=Salamo",
    },
    "2027-01-23": {
      "dateLabel": "Sab 23 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:46:10&name=Salamo",
      "key": "19:46:10",
      "label": "Fampaherezana",
      "ref": "Salamo 46:10",
      "text": "Mitsahara, ka aoka ho fantatrareo fa Izaho no Andriamanitra; hisandratra amin'ny firenen-tsamy hafa Aho, hisandratra amin'ny tany Aho.",
      "url": "ebaiboly://verse?book=19&chapter=46&verse=10&name=Salamo",
    },
    "2027-01-24": {
      "dateLabel": "Alh 24 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:46:7&name=Salamo",
      "key": "19:46:7",
      "label": "Fampaherezana",
      "ref": "Salamo 46:7",
      "text": "Jehovah, Tompon'ny maro, no momba antsika; Andriamanitr'i Jakoba no fiarovana avo ho antsika. [Sela.]",
      "url": "ebaiboly://verse?book=19&chapter=46&verse=7&name=Salamo",
    },
    "2027-01-25": {
      "dateLabel": "Alt 25 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:55:6&name=Isaia",
      "key": "23:55:6",
      "label": "Fampaherezana",
      "ref": "Isaia 55:6",
      "text": "Mitadiava an'i Jehovah, dieny mbola hita Izy, Miantsoa Azy, dieny mbola akaiky Izy.",
      "url": "ebaiboly://verse?book=23&chapter=55&verse=6&name=Isaia",
    },
    "2027-01-26": {
      "dateLabel": "Tal 26 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:40:31&name=Isaia",
      "key": "23:40:31",
      "label": "Fampaherezana",
      "ref": "Isaia 40:31",
      "text": "Fa izay miandry an'i Jehovah dia mandroso hery kosa; Elatra no hiakarany tahaka ny voromahery; Hihazakazaka izy, nefa tsy ho sasatra; Handeha izy, nefa tsy ho reraka.",
      "url": "ebaiboly://verse?book=23&chapter=40&verse=31&name=Isaia",
    },
    "2027-01-27": {
      "dateLabel": "Alr 27 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=24:33:3&name=Jeremia",
      "key": "24:33:3",
      "label": "Fampaherezana",
      "ref": "Jeremia 33:3",
      "text": "Antsoy Aho, dia hovaliako ianao ka hampisehoako zavatra lehibe sy saro-pantarina izay tsy fantatrao.",
      "url": "ebaiboly://verse?book=24&chapter=33&verse=3&name=Jeremia",
    },
    "2027-01-28": {
      "dateLabel": "Alk 28 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=6:1:9&name=Josoa",
      "key": "6:1:9",
      "label": "Fampaherezana",
      "ref": "Josoa 1:9",
      "text": "Tsy efa nandidy anao va Aho? Koa mahereza sy matanjaha; aza matahotra na mivadi-po, fa momba anao Jehovah Andriamanitrao amin'izay rehetra alehanao.",
      "url": "ebaiboly://verse?book=6&chapter=1&verse=9&name=Josoa",
    },
    "2027-01-29": {
      "dateLabel": "Zom 29 Jan",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=20:18:10&name=Ohabolana",
      "key": "20:18:10",
      "label": "Fampaherezana",
      "ref": "Ohabolana 18:10",
      "text": "Ny anaran'i Jehovah dia tilikambo mafy; Ny marina miezaka ho ao aminy ka voavonjy.",
      "url": "ebaiboly://verse?book=20&chapter=18&verse=10&name=Ohabolana",
    },
  },
