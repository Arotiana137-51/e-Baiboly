exports[`widget feed: 60 days from a fixed date a plan on the widget, a favorite, text settings and dark mode 1`] = `
{
  "days": {
    "2026-12-01": {
      "dateLabel": "Tal 1 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:34:18&name=Salamo",
      "key": "19:34:18",
      "label": "Teny ho anao · 1/21",
      "ref": "Salamo 34:18",
      "text": "Akaikin'izay manana fo mangorakoraka Jehovah, ary mamonjy izay torororo fanahy.",
      "url": "ebaiboly://verse?book=19&chapter=34&verse=18&name=Salamo",
    },
    "2026-12-02": {
      "dateLabel": "Alr 2 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=40:5:4&name=Matio",
      "key": "40:5:4",
      "label": "Teny ho anao · 2/21",
      "ref": "Matio 5:4",
      "text": "Sambatra ny ory; fa izy no hampifaliana.",
      "url": "ebaiboly://verse?book=40&chapter=5&verse=4&name=Matio",
    },
    "2026-12-03": {
      "dateLabel": "Alk 3 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=43:11:35&name=Jaona",
      "key": "43:11:35",
      "label": "Teny ho anao · 3/21",
      "ref": "Jaona 11:35",
      "text": "Jesosy nitomany.",
      "url": "ebaiboly://verse?book=43&chapter=11&verse=35&name=Jaona",
    },
    "2026-12-04": {
      "dateLabel": "Zom 4 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:147:3&name=Salamo",
      "key": "19:147:3",
      "label": "Teny ho anao · 4/21",
      "ref": "Salamo 147:3",
      "text": "Mahasitrana ny torotoro fo Izy Sy mamehy ny feriny.",
      "url": "ebaiboly://verse?book=19&chapter=147&verse=3&name=Salamo",
    },
    "2026-12-05": {
      "dateLabel": "Sab 5 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:23:4&name=Salamo",
      "key": "19:23:4",
      "label": "Teny ho anao · 5/21",
      "ref": "Salamo 23:4",
      "text": "Eny, na dia mandeha mamaky ny lohasaha aloky ny fahafatesana aza aho, dia tsy hatahotra ny loza aho, fa Ianao no amiko; ny tsorakazonao sy ny tehinao, ireo no mahafa-tahotra ahy.",
      "url": "ebaiboly://verse?book=19&chapter=23&verse=4&name=Salamo",
    },
    "2026-12-06": {
      "dateLabel": "Alh 6 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:43:2&name=Isaia",
      "key": "23:43:2",
      "label": "Teny ho anao · 6/21",
      "ref": "Isaia 43:2",
      "text": "Raha mita ny rano ianao, dia homba anao Aho; Ary raha mita ny ony ianao, dia tsy hanafotra anao izy; Raha mandeha mamaky ny afo ianao, dia tsy ho may, Ary tsy hirehitra aminao ny lelafo;",
      "url": "ebaiboly://verse?book=23&chapter=43&verse=2&name=Isaia",
    },
    "2026-12-07": {
      "dateLabel": "Alt 7 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:56:8&name=Salamo",
      "key": "19:56:8",
      "label": "Teny ho anao · 7/21",
      "ref": "Salamo 56:8",
      "text": "Manisa ny firenireneko Ianao; ataovy ao an-tavoahanginao ny ranomasoko; tsy eo amin'ny bokinao va ireny?",
      "url": "ebaiboly://verse?book=19&chapter=56&verse=8&name=Salamo",
    },
    "2026-12-08": {
      "dateLabel": "Tal 8 Des",
      "label": "",
      "ref": "Teny ho anao",
      "text": "Mbola mety aminao ve ireo teny ireo? Tsindrio eto raha hamaly.",
      "url": "ebaiboly://teny-ho-anao",
    },
    "2026-12-09": {
      "dateLabel": "Alr 9 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=25:3:22-23&name=Fitomaniana",
      "key": "25:3:22-23",
      "label": "Teny ho anao · 8/21",
      "ref": "Fitomaniana 3:22-23",
      "text": "Ny famindram-pon'i Jehovah no tsy nahalany ritra antsika, fa tsy mitsahatra ny fiantrany. Vaovao isa-maraina izany; lehibe ny fahamarinanao.",
      "url": "ebaiboly://verse?book=25&chapter=3&verse=22&name=Fitomaniana",
    },
    "2026-12-10": {
      "dateLabel": "Alk 10 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=19:42:11&name=Salamo",
      "key": "19:42:11",
      "label": "Teny ho anao · 9/21",
      "ref": "Salamo 42:11",
      "text": "Nahoana no mitanondrika ianao, ry fanahiko? ary nahoana no mitoloko ato anatiko ianao? Manantenà an'Andriamanitra, fa mbola hidera Azy ihany aho, Izy no famonjena ny tavako sady Andriamanitro.",
      "url": "ebaiboly://verse?book=19&chapter=42&verse=11&name=Salamo",
    },
    "2026-12-11": {
      "dateLabel": "Zom 11 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=9:12:24&name=I%20Samoela",
      "key": "9:12:24",
      "label": "Fampaherezana",
      "ref": "1 Samoela 12:24",
      "text": "Kanefa matahora an'i Jehovah ianareo, ka manompoa Azy marina amin'ny fonareo rehetra; fa eritrereto izao zavatra lehibe nataony ho anareo izao.",
      "url": "ebaiboly://verse?book=9&chapter=12&verse=24&name=I%20Samoela",
    },
    "2026-12-12": {
      "dateLabel": "Sab 12 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=25:3:24&name=Fitomaniana",
      "key": "25:3:24",
      "label": "Fampaherezana",
      "ref": "Fitomaniana 3:24",
      "text": "Jehovah no anjarako, hoy ny fanahiko, ka dia hanantena Azy aho.",
      "url": "ebaiboly://verse?book=25&chapter=3&verse=24&name=Fitomaniana",
    },
    "2026-12-13": {
      "dateLabel": "Alh 13 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=14:16:9&name=II%20Tantara",
      "key": "14:16:9",
      "label": "Fampaherezana",
      "ref": "2 Tantara 16:9",
      "text": "Fa ny mason'i Jehovah mijery eny tontolo eny eran'ny tany rehetra, mba hisehoany aman-kery hamonjy izay manana fo mahitsy aminy. Adala ianao tamin'izany, ka dia hisy ady hahazo anao hatramin'izao.",
      "url": "ebaiboly://verse?book=14&chapter=16&verse=9&name=II%20Tantara",
    },
    "2026-12-14": {
      "dateLabel": "Alt 14 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=20:13:12&name=Ohabolana",
      "key": "20:13:12",
      "label": "Fampaherezana",
      "ref": "Ohabolana 13:12",
      "text": "Ny fanantenana tsy azo vetivety dia mankarary am-bavafo; Fa hazon'aina ny faniriana tanteraka.",
      "url": "ebaiboly://verse?book=20&chapter=13&verse=12&name=Ohabolana",
    },
    "2026-12-15": {
      "dateLabel": "Tal 15 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=45:8:35&name=Romana",
      "key": "45:8:35",
      "label": "Fampaherezana",
      "ref": "Romana 8:35",
      "text": "Iza no hahasaraka antsika amin'ny fitiavan'i Kristy? Fahoriana va, sa fahantrana, sa fanenjehana, sa mosary, sa fitanjahana, sa loza, sa sabatra?",
      "url": "ebaiboly://verse?book=45&chapter=8&verse=35&name=Romana",
    },
    "2026-12-16": {
      "dateLabel": "Alr 16 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=20:19:20&name=Ohabolana",
      "key": "20:19:20",
      "label": "Fampaherezana",
      "ref": "Ohabolana 19:20",
      "text": "Henoy ny saina atolotra, ary raiso ny fananarana, Mba ho hendry ianao amin'izay hiafaranao.",
      "url": "ebaiboly://verse?book=20&chapter=19&verse=20&name=Ohabolana",
    },
    "2026-12-17": {
      "dateLabel": "Alk 17 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=40:28:18&name=Matio",
      "key": "40:28:18",
      "label": "Fampaherezana",
      "ref": "Matio 28:18",
      "text": "Ary Jesosy nanatona dia niteny taminy ka nanao hoe: Efa nomena Ahy ny fahefana rehetra any an-danitra sy ety an-tany;",
      "url": "ebaiboly://verse?book=40&chapter=28&verse=18&name=Matio",
    },
    "2026-12-18": {
      "dateLabel": "Zom 18 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=42:12:24&name=Lioka",
      "key": "42:12:24",
      "label": "Fampaherezana",
      "ref": "Lioka 12:24",
      "text": "Hevero ny goaika; fa tsy mba mamafy na mijinja ireny; ary tsy manana fitoeran-javatra na trano fitehirizana, nefa Andriamanitra mamelona azy; tsy mihoatra lavitra noho ny vorona va ianareo?",
      "url": "ebaiboly://verse?book=42&chapter=12&verse=24&name=Lioka",
    },
    "2026-12-19": {
      "dateLabel": "Sab 19 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=43:14:2&name=Jaona",
      "key": "43:14:2",
      "label": "Fampaherezana",
      "ref": "Jaona 14:2",
      "text": "Ao an-tranon'ny Raiko misy fitoerana maro; raha tsy izany, dia efa nilaza taminareo Aho; fa handeha hamboatra fitoerana ho anareo Aho.",
      "url": "ebaiboly://verse?book=43&chapter=14&verse=2&name=Jaona",
    },
    "2026-12-20": {
      "dateLabel": "Alh 20 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=45:10:13&name=Romana",
      "key": "45:10:13",
      "label": "Fampaherezana",
      "ref": "Romana 10:13",
      "text": "Fa izay rehetra miantso ny anaran'ny Tompo no hovonjena.",
      "url": "ebaiboly://verse?book=45&chapter=10&verse=13&name=Romana",
    },
    "2026-12-21": {
      "dateLabel": "Alt 21 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=42:6:37&name=Lioka",
      "key": "42:6:37",
      "label": "Fampaherezana",
      "ref": "Lioka 6:37",
      "text": "Ary aza mitsara, dia tsy hotsaraina ianareo; aza manameloka, dia tsy hohelohina ianareo; mamelà, dia mba havela ianareo;",
      "url": "ebaiboly://verse?book=42&chapter=6&verse=37&name=Lioka",
    },
    "2026-12-22": {
      "dateLabel": "Tal 22 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=46:13:8&name=I%20Korintiana",
      "key": "46:13:8",
      "label": "Fampaherezana",
      "ref": "1 Korintiana 13:8",
      "text": "Ny fitiavana tsy ho levona mandrakizay; fa raha ny faminaniana, dia ho levona; na ny fiteny tsy fantatra, dia hitsahatra; na ny fahalalana, dia ho foana.",
      "url": "ebaiboly://verse?book=46&chapter=13&verse=8&name=I%20Korintiana",
    },
    "2026-12-23": {
      "dateLabel": "Alr 23 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=50:4:19&name=Filipiana",
      "key": "50:4:19",
      "label": "Fampaherezana",
      "ref": "Filipiana 4:19",
      "text": "Fa Andriamanitro hahatanteraka izay rehetra tokony ho anareo araka ny hareny amin'ny voninahitra ao amin'i Kristy Jesosy.",
      "url": "ebaiboly://verse?book=50&chapter=4&verse=19&name=Filipiana",
    },
    "2026-12-24": {
      "dateLabel": "Alk 24 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=42:2:10-11&name=Lioka",
      "key": "42:2:10-11",
      "label": "Fampaherezana",
      "ref": "Lioka 2:10-11",
      "text": "Ary hoy ny anjely taminy: Aza matahotra; fa, indro, milaza teny soa mahafaly aminareo aho, dia fifaliana lehibe izay ho an'ny olona rehetra; fa Mpamonjy no teraka ho anareo anio ao an-tanànan'i Davida, dia Kristy Tompo.",
      "url": "ebaiboly://verse?book=42&chapter=2&verse=10&name=Lioka",
    },
    "2026-12-25": {
      "dateLabel": "Zom 25 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=23:9:5&name=Isaia",
      "key": "23:9:5",
      "label": "Fampaherezana",
      "ref": "Isaia 9:5",
      "text": "Fa Zaza no teraka ho antsika, Zazalahy no omena antsika; Ary ny fanapahana dia eo an-tsorony, ary ny anarany atao hoe Mahagaga, Mpanolo-tsaina, Andriamanitra Mahery, Rain'ny mandrakizay Andrian'ny fiadanana.",
      "url": "ebaiboly://verse?book=23&chapter=9&verse=5&name=Isaia",
    },
    "2026-12-26": {
      "dateLabel": "Sab 26 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=43:1:14&name=Jaona",
      "key": "43:1:14",
      "label": "Fampaherezana",
      "ref": "Jaona 1:14",
      "text": "Ary ny Teny dia tonga nofo ka nonina tamintsika; ary hitanay ny voninahiny, dia voninahitra miendrika ho an'ny Lahitokana avy tamin'ny Ray, sady feno fahasoavana sy fahamarinana.",
      "url": "ebaiboly://verse?book=43&chapter=1&verse=14&name=Jaona",
    },
    "2026-12-27": {
      "dateLabel": "Alh 27 Des",
      "fav": false,
      "favUrl": "ebaiboly://favorite?key=62:5:13&name=I%20Jaona",
      "key": "62:5:13",
      "label": "Fampaherezana",
      "ref": "1 Jaona 5:13",
      "text": "Izany no nosoratako aminareo, izay mino ny anaran'ny Zanak'Andriamanitra, mba ho fantatrareo fa manana fiainana mandrakizay ianareo.",
      "url": "ebaiboly://verse?book=62&chapter=5&verse=13&name=I%20Jaona",
    },
    "2026-12-28": {
