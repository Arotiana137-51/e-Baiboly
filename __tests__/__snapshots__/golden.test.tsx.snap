      "fav": false,
      "favUrl": "ebaiboly://favorite?key=40:11:28&name=Matio",
      "key": "40:11:28",
      "label": "Fampaherezana",
      "ref": "Matio 11:28",
      "text": "Mankanesa aty amiko, ianareo rehetra izay miasa fatratra sy mavesatra entana, fa Izaho no hanome anareo fitsaharana.",
      "url": "ebaiboly://verse?book=40&chapter=11&verse=28&name=Matio",
